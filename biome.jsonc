{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "files": {
    "includes": [
      "**",
      // Rewritten by trunk upgrade
      "!**/.trunk"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "useEditorconfig": true
  },
  "markdown": {
    // The front matter of the SKILL.md of a skill, which the parser reads as
    // Markdown otherwise, and turns its YAML into a heading. Biome takes the
    // options of the parser only for the files under the directory of the
    // configuration, so Trunk copies it to its sandbox.
    "parser": {
      "frontmatter": true
    }
  },
  "yaml": {
    "formatter": {
      // An expression of GitHub Actions reads better on one line
      "lineWidth": 120
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "nursery": {
        // Markdown, where the rest of the rules of markdownlint are about
        // formatting, which the formatter does; not useTopLevelHeading, as
        // CLAUDE.md starts with the import of AGENTS.md
        "useConsistentHeadingLevel": "error",
        "useFencedCodeLanguage": "error",
        "useSingleTopLevelHeading": "error"
      },
      "preset": "recommended"
    }
  },
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
